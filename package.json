{
  "name": "real-browser-mcp-server",
  "version": "2.1.5",
  "description": "MCP Server for Real Browser - Patchright Ad Blocker.",
  "main": "dist/lib/cjs/index.js",
  "module": "lib/esm/index.mjs",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./typings.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./dist/lib/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "lib/esm",
    "typings.d.ts"
  ],
  "typings": "typings.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "real-browser-mcp": "./dist/src/index.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc && node dist/scripts/generate-esm.js && node -e \"console.log('\\n✅ Build Successful! The dist/ folder is ready.\\n')\"",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node dist/src/index.js",
    "mcp": "node dist/src/index.js mcp",
    "mcp:verbose": "node dist/src/index.js mcp --verbose",
    "list": "node dist/src/index.js --list",
    "test": "npm run cjs_test && npm run esm_test",
    "cjs_test": "node ./test/test.mjs --cjs",
    "esm_test": "node ./test/test.mjs --esm",
    "mcp_test": "node --test ./test/mcp-smoke.mjs"
  },
  "keywords": [
    "mcp-server",
    "model-context-protocol",
    "patchright",
    "playwright",
    "browser-automation",
    "web-automation",
    "web-testing",
    "automation"
  ],
  "author": "codeiva4u",
  "license": "ISC",
  "dependencies": {
    "@ghostery/adblocker-playwright": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "ghost-cursor-patchright": "latest",
    "patchright": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
